{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "license": "${license}",
  "authors": ["Salt"],
  "environment": "client",
  "mixins": ["salts_inventory_controlify.mixins.json"],
  "entrypoints": {
    "client": ["com.salts_inventory_update.controlify.SaltsControlifyFabricClient"]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}",
    "fabric-api": "*",
    "salts_inventory_update": "=${legacy_core_version}",
    "controlify": "2.0.4"
  }
}
