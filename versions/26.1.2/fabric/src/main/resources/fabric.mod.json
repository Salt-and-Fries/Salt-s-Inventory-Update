{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "license": "${license}",
  "authors": [
    "Salt"
  ],
  "icon": "assets/salts_inventory_update/icon.png",
  "contact": {
    "homepage": "https://salt-and-fries.github.io/Salt-s-Inventory-Update/",
    "sources": "https://github.com/Salt-and-Fries/Salt-s-Inventory-Update",
    "issues": "https://github.com/Salt-and-Fries/Salt-s-Inventory-Update/issues",
    "discord": "https://discord.gg/kfdE9gGGxP"
  },
  "entrypoints": {
    "main": [
      "com.salts_inventory_update.SaltsInventoryUpdateFabric"
    ],
    "client": [
      "com.salts_inventory_update.SaltsInventoryUpdateFabricClient"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json",
    "${mod_id}.fabric-hud.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}",
    "fabric-api": "*"
